# Copy to .env at the repository root (git-ignored) and fill in the values. The server, the job worker, the GPU
# broker and the console tools read it when they start. Only the names are listed here.

# OpenAI: every text, decision, transcription and GPT Image call (config/genai.example.json reads it as
# "env:OPENAI_API_KEY").
OPENAI_API_KEY=

# On the GPU PC only: the token production sends to the GPU broker (config/broker.example.json reads it as
# "env:DAYDREAM_BROKER_TOKEN_PROD").
DAYDREAM_BROKER_TOKEN_PROD=

# Optional settings, each with a default when left out:
# DAYDREAM_PORT=             the game server's port (3000)
# DAYDREAM_HOST=             the address the server listens on
# DAYDREAM_DATA_DIR=         where accounts, worlds and adventures live (data/)
# DAYDREAM_GENAI_CONFIG=     the models' settings file (config/genai.json)
# DAYDREAM_WORKER=           "external" when jobs run in separate worker processes (npm run worker -w @daydream/server)
# DAYDREAM_BROKER_CONFIG=    the GPU broker's config file (config/broker.json)
# DAYDREAM_BACKUP_DIR=       where the nightly snapshots go (data/backups/)
# COMFY_URL=                 the GPU broker's address, in place of the comfyui provider's baseUrl
# PLAYTEST_CHROME=           the Chromium-based browser the playtest harness drives

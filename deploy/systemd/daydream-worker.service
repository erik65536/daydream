# The job worker: world builds, painting (on the GPU PC's ComfyUI), rules and studio work. Lower CPU priority than
# the game server, so a balance simulation never makes play stutter. Stopping it pauses jobs at a safe point; they
# resume from their checkpoints when it starts again.
[Unit]
Description=Daydream job worker
After=network-online.target daydream-server.service
Wants=network-online.target

[Service]
User=daydream
Group=daydream
WorkingDirectory=/opt/daydream/packages/server
ExecStart=/usr/bin/node src/worker.ts
Environment=NODE_ENV=production DAYDREAM_DATA_DIR=/var/lib/daydream DAYDREAM_GENAI_CONFIG=/etc/daydream/genai.json
LoadCredentialEncrypted=openai
# The GPU broker's token (comfy provider "apiKey": "credential:gpu-broker").
LoadCredentialEncrypted=gpu-broker
Restart=always
RestartSec=2
TimeoutStopSec=180
Nice=10
CPUWeight=30

StateDirectory=daydream
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

# The game server: HTTP API, game sockets and the built client, behind Caddy on this machine.
[Unit]
Description=Daydream game server
After=network-online.target
Wants=network-online.target

[Service]
User=daydream
Group=daydream
WorkingDirectory=/opt/daydream/packages/server
ExecStart=/usr/bin/node src/index.ts
Environment=NODE_ENV=production DAYDREAM_HOST=127.0.0.1 DAYDREAM_PORT=3000 DAYDREAM_WORKER=external
Environment=DAYDREAM_DATA_DIR=/var/lib/daydream DAYDREAM_GENAI_CONFIG=/etc/daydream/genai.json
# The OpenAI key: a file only this service can read (provider "apiKey": "credential:openai"), never in the environment.
LoadCredentialEncrypted=openai
# The GPU broker's token (comfy provider "apiKey": "credential:gpu-broker").
LoadCredentialEncrypted=gpu-broker
Restart=always
RestartSec=2
# Saves are written on SIGTERM.
TimeoutStopSec=30

StateDirectory=daydream
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
